.footer-banner {
    position: fixed;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 10;
    width: 768px;
}
#footer-banner-close {
    position: absolute;
    right: -24px;
